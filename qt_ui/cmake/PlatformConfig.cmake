# 平台编译宏定义（开发大纲第 6 章）
# Windows: CRAFTMASTER_PLATFORM_WINDOWS
# OpenHarmony: CRAFTMASTER_PLATFORM_OHOS + __OHOS__（鸿蒙 SDK 侧也定义 __OHOS__）

if(WIN32)
  set(CRAFTMASTER_PLATFORM_DEFINITIONS CRAFTMASTER_PLATFORM_WINDOWS)
elseif(CMAKE_SYSTEM_NAME STREQUAL "OpenHarmony" OR DEFINED OHOS)
  set(CRAFTMASTER_PLATFORM_DEFINITIONS CRAFTMASTER_PLATFORM_OHOS __OHOS__)
else()
  message(WARNING "BeanDraw: unknown target platform '${CMAKE_SYSTEM_NAME}', falling back to Windows definitions")
  set(CRAFTMASTER_PLATFORM_DEFINITIONS CRAFTMASTER_PLATFORM_WINDOWS)
endif()
